common --registry="https://raw.githubusercontent.com/dejwk/roo-registry/main/" --registry="https://bcr.bazel.build"

import %workspace%/.roo_testing/bazelrc/esp32/base.bazelrc
import %workspace%/.roo_testing/bazelrc/esp32/idf.bazelrc
import %workspace%/.roo_testing/bazelrc/esp32/arduino.bazelrc

# Bazelisk defaults configured commands to Arduino unless a frontend is selected.

# gtest assertion templates frequently trigger sign-compare diagnostics in
# test sources despite equivalent runtime semantics.
build --per_file_copt=test/.*@-Wno-sign-compare

# GCC 13 may report false positives from libstdc++ internals while compiling
# external glog sources that use std::regex.
build --per_file_copt=external/glog.*/.*@-Wno-maybe-uninitialized

build:asan --strip=never
build:asan --copt -fsanitize=address
build:asan --copt -DADDRESS_SANITIZER
build:asan --copt -O1
build:asan --copt -g
build:asan --copt -fno-omit-frame-pointer
build:asan --linkopt -fsanitize=address
