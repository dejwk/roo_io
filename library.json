{
    "name": "roo_io",
    "description": "Unified I/O library for microcontrollers. Supports ESP32 Arduino/ESP-IDF and RP2040 Arduino-Pico/Pico SDK.",
    "keywords": [],
    "authors": [
        {
            "name": "Dawid Kurzyniec",
            "email": "dejwk.oss@gmail.com",
            "maintainer": true
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/dejwk/roo_io"
    },
    "version": "2.5.0",
    "homepage": "https://github.com/dejwk/roo_io",
    "build": {
        "srcDir": "src",
        "srcFilter": "+<*> -<examples> -<benchmarks> -<doc> -<test>"
    },
    "examples": [
        "examples/**/*.ino"
    ],
    "dependencies": {
        "dejwk/roo_backport": ">=1.2.4",
        "dejwk/roo_logging": ">=1.6.0",
        "dejwk/roo_threads": ">=1.3.0"
    }
}
